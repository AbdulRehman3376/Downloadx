{
  "manifest_version": 3,
  "name": "DownloadX",
  "version": "0.3.1",
  "description": "IDM-style download dashboard with persistent task list, queue, and native video downloads.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "storage",
    "tabs",
    "downloads",
    "cookies"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
 "action": {
  "default_title": "DownloadX – open download manager"
}

}